  "scenes": [
    {
      "scene_no": 1,
      "location": "南方饲料企业实验室",
      "participants": [
        "苏牧"
      ],
      "conflict": "公司要按十月九日的报价走一批进口苜蓿，苏牧算出要多付十九万六；娜仁的电话打来时他先问的是父亲最后一次割是哪一天，而不是问病情。",
      "summary": "深夜实验室，苏牧用自建的苜蓿蛋白预测模型挡下客户的报价，接到娜仁电话，得知父亲进了卫生院。他算出父亲割晚了十一天，然后带着三年的旧纸箱回到草原。",
      "dialogue_function": "确立苏牧的数据化人格：把亲人的死因当作待求解的方程。"
    },
    {
      "scene_no": 2,
      "location": "巴音乌拉草场 苜蓿地",
      "participants": [
        "苏牧",
        "娜仁"
      ],
      "conflict": "苏牧用量和记录算出父亲割晚了十一天，算出冬料差三成；他算得越准，越无法解释父亲明知还要割。他只能得出父亲明知而为之，这比任何数字都难接受。",
      "summary": "苏牧在割晒机旁见到父亲遗物，量留茬、翻刈割记录和冬料手账，算出晚了十一天与差三十吨。他在毡帽下找到父亲的纸条，在棚里发现一箱无品种名种子。娜仁第一次点明：北边那片地是他知道是草场还开垦的。",
      "dialogue_function": "让父亲的技术错误与意志错误同时显影；纸条承担遗言，种子承担来源之谜。"
    },
    {
      "scene_no": 3,
      "location": "苏家牛场 棚圈外",
      "participants": [
        "苏牧",
        "娜仁"
      ],
      "conflict": "娜仁用『我还没到要人帮忙的地步』把苏牧的帮忙推回去，用『九十七头』把话岔开。她要守住这个数，苏牧要追问的就是这个。母亲的沉默与儿子的追问在同一堆香灰上互相抵死。",
      "summary": "夜里棚圈外，娜仁烧纸钱，把旧库房钥匙压在香灰下，说父亲留话等她回来再看。苏牧追问账目，娜仁只说九年前死了九十七头牛，然后闭口。",
      "dialogue_function": "把家庭债与草场债并置：娜仁守着一个数，苏牧想算的是一笔账。"
    }
  ],
